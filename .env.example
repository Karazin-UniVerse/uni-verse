# Server Configuration
# Optional Chrome executable for local Lighthouse audits/tests (otherwise uses installed Chrome).
# CHROME_PATH=
PORT=3001
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/universe?schema=public"

# JWT Authentication Secrets (Generate secure random 32+ char strings in production)
AT_SECRET=""
RT_SECRET=""

# Moodle Integration
MOODLE_BASEURL="https://moodle.universemvp.tech"
MOODLE_TIMEOUT=15000

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# Google OAuth 2.0 (SSO & Account Linking)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_ALLOWED_DOMAINS="karazin.ua,student.karazin.ua"

# Opportunities / Internships module toggle
NEXT_PUBLIC_FEATURE_OPPORTUNITIES=false

# Moodle LMS integration toggle (courses, grades, assignments sync)
NEXT_PUBLIC_FEATURE_MOODLE=true

# eDean academic system toggle (schedule, academic status)
NEXT_PUBLIC_FEATURE_EDEAN=true

# Developer feature flags control panel toggle
NEXT_PUBLIC_FEATURE_PANEL=false


# Grip AI Gateway (developer pre-push quiz gateway to Gemini)
GRIP_GATEWAY_ENABLED=false
GEMINI_API_KEYS=""
GRIP_GEMINI_MODEL="gemini-3.5-flash-lite"
GRIP_GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
GRIP_GITHUB_API_URL="https://api.github.com"
GRIP_GITHUB_OAUTH_CLIENT_ID=""
GRIP_GITHUB_PERMISSION_TOKEN=""
GRIP_GITHUB_OWNER="Karazin-UniVerse"
GRIP_GITHUB_REPOSITORY="uni-verse"
GRIP_TRUSTED_PROXY_ADDRESSES="127.0.0.1,::1"

# GitHub Actions deployment configuration (GitHub variables, NOT application env).
# See docs/deployment.md. Repository variable: GCP_DEPLOY_ENABLED.
# develop environment variables: GCP_PROJECT_ID, GCP_REGION,
# GCP_ARTIFACT_REPOSITORY, GCP_BACKEND_SERVICE, GCP_FRONTEND_SERVICE,
# GCP_WORKLOAD_IDENTITY_PROVIDER, GCP_DEPLOY_SERVICE_ACCOUNT,
# NEXT_PUBLIC_API_URL, FRONTEND_URL, GOOGLE_CLIENT_ID.

{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc", "import"],
  "jsPlugins": ["./configs/oxlint/plugins/universe-rules.mjs"],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": [
      "warn",
      {
        "allow": ["warn", "error", "info"]
      }
    ],
    "eqeqeq": "error",
    "import/no-duplicates": "error",
    "import/no-cycle": "error",
    "react/jsx-key": "error",
    "react/jsx-no-useless-fragment": "warn",
    "react/no-danger": "warn",
    "react/no-direct-mutation-state": "error",
    "react/self-closing-comp": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "typescript/no-explicit-any": "warn",
    "universe/vertical-spacing": "error",
    "universe/destructuring-props-order": "error",
    "universe/no-suppress-hydration-without-comment": "warn",
    "universe/nestjs-require-api-response-type": "error",
    "universe/nestjs-require-bearer-auth-decorator": "error",
    "universe/nestjs-controller-return-type": "error",
    "universe/una-primitive-purity": "error",
    "universe/nestjs-controller-no-prisma": "error",
    "universe/no-empty-catch-in-services": "error",
    "universe/core-package-isolation": "error",
    "react/no-multi-comp": "error"
  },
  "overrides": [
    {
      "files": [
        "**/*.spec.{ts,tsx,js,jsx}",
        "**/*.test.{ts,tsx,js,jsx}",
        "**/*.e2e-spec.{ts,tsx,js,jsx}",
        "**/tests/**",
        "**/test/**",
        "**/*.stories.{ts,tsx,js,jsx}",
        "**/.storybook/**"
      ],
      "rules": {
        "typescript/no-explicit-any": "off",
        "react/no-multi-comp": "off"
      }
    },
    {
      "files": ["packages/uni-hub/**/*.{ts,tsx,js,jsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../utils/**", "../../utils/**", "../../../utils/**"],
                "message": "Use package alias '@uni-hub/utils/...' instead of relative '../utils/...' path."
              },
              {
                "group": [
                  "@universe/backend",
                  "@universe/backend/**",
                  "@universe/database",
                  "@universe/database/**",
                  "prisma",
                  "@prisma/**"
                ],
                "message": "Frontend cannot directly import backend or database code. Access data via HTTP API clients (@uni-hub/services/api)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/uni-hub/app/providers.tsx"],
      "rules": {
        "react/no-danger": "off"
      }
    },
    {
      "files": ["packages/ui/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@uni-hub",
                  "@uni-hub/**",
                  "@universe/backend",
                  "@universe/backend/**",
                  "@universe/database",
                  "@universe/database/**"
                ],
                "message": "UI package cannot depend on application packages. Design system must remain independent."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/backend/**/*.{ts}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react-dom",
                  "next",
                  "next/**",
                  "@uni-hub",
                  "@uni-hub/**",
                  "@universe/ui",
                  "@universe/ui/**"
                ],
                "message": "Backend cannot import frontend or React libraries."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/core/**/*.{ts}"],
      "rules": {
        "oxc/no-barrel-file": ["error", { "threshold": 0 }],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@nestjs/**",
                  "react",
                  "react-dom",
                  "next",
                  "next/**",
                  "@universe/backend",
                  "@universe/backend/**",
                  "@universe/database",
                  "@universe/database/**",
                  "express",
                  "zustand",
                  "@universe/ui",
                  "@universe/ui/**",
                  "@uni-hub",
                  "@uni-hub/**"
                ],
                "message": "@universe/core is a pure domain contract package."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/packages/database/client/**",
    "**/.agents/**",
    "**/agent/**",
    "**/.claude/**"
  ]
}

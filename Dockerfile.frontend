FROM node:20-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV COREPACK_HOME="/usr/local/share/corepack"
ENV PATH="$PNPM_HOME:$PATH"
RUN apk add --no-cache libc6-compat
RUN mkdir -p /usr/local/share/corepack && chmod -R 777 /usr/local/share/corepack
RUN corepack enable && corepack prepare pnpm@10.0.0 --activate

FROM base AS builder
WORKDIR /app
COPY . .
ARG NEXT_PUBLIC_API_URL=https://p01--backend--jm9qjnmpm4m2.code.run
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @universe/uni-hub build

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000

COPY --from=builder --chown=node:node /app /app

USER node
EXPOSE 3000

WORKDIR /app/packages/uni-hub
CMD ["./node_modules/.bin/next", "start"]

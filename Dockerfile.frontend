FROM node:24.20.0-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV COREPACK_HOME="/usr/local/share/corepack"
ENV PATH="$PNPM_HOME:$PATH"
RUN apk add --no-cache libc6-compat
RUN mkdir -p /usr/local/share/corepack && chmod -R 777 /usr/local/share/corepack
RUN corepack enable && corepack prepare pnpm@10.0.0 --activate

FROM base AS builder
WORKDIR /app
COPY . .
ARG NEXT_PUBLIC_API_URL=https://api.universemvp.tech
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID
ENV NEXT_PUBLIC_GOOGLE_CLIENT_ID=$NEXT_PUBLIC_GOOGLE_CLIENT_ID
ARG NEXT_PUBLIC_FEATURE_MOODLE
ENV NEXT_PUBLIC_FEATURE_MOODLE=$NEXT_PUBLIC_FEATURE_MOODLE
ARG NEXT_PUBLIC_FEATURE_EDEAN
ENV NEXT_PUBLIC_FEATURE_EDEAN=$NEXT_PUBLIC_FEATURE_EDEAN
ARG NEXT_PUBLIC_FEATURE_OPPORTUNITIES
ENV NEXT_PUBLIC_FEATURE_OPPORTUNITIES=$NEXT_PUBLIC_FEATURE_OPPORTUNITIES
ARG NEXT_PUBLIC_FEATURE_PANEL
ENV NEXT_PUBLIC_FEATURE_PANEL=$NEXT_PUBLIC_FEATURE_PANEL
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @universe/core build && pnpm --filter @universe/ui build-storybook
RUN cp -r packages/ui/storybook-static packages/uni-hub/public/storybook
RUN sed -i 's|<head>|<head><base href="/storybook/">|g' packages/uni-hub/public/storybook/index.html && \
    sed -i 's|<head>|<head><base href="/storybook/">|g' packages/uni-hub/public/storybook/iframe.html
RUN pnpm --filter @universe/uni-hub build
RUN cd packages/grip/frontend && ./node_modules/.bin/next build

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8080

RUN apk add --no-cache nginx bash curl

COPY --from=builder --chown=node:node /app /app

USER node
EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s CMD curl --fail --silent --max-time 3 "http://127.0.0.1:${PORT}/readyz" > /dev/null || exit 1
CMD ["bash", "/app/docker/frontend/entrypoint.sh"]

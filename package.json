{
  "name": "uni-verse",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "oxlint --deny-warnings",
    "lint:ox": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "db:generate": "pnpm --filter @universe/backend db:generate",
    "db:migrate": "pnpm --filter @universe/backend db:push",
    "db:studio": "pnpm --filter @universe/backend db:studio"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.5.0",
    "sass-embedded": "^1.100.0",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  }
}

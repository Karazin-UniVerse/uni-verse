{
  "name": "uni-verse",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "oxlint --deny-warnings",
    "lint:ox": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings && stylelint \"**/*.{css,scss}\" --fix && prettier --write .",
    "lint:style": "stylelint \"**/*.{css,scss}\"",
    "lint:style:fix": "stylelint \"**/*.{css,scss}\" --fix",
    "fix": "pnpm lint:fix",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "vitest run --config tests/e2e/vitest.config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "db:generate": "pnpm --filter @universe/backend db:generate",
    "db:migrate": "pnpm --filter @universe/backend db:push",
    "db:studio": "pnpm --filter @universe/backend db:studio"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxlint": "^1.82.0",
    "prettier": "^3.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sass-embedded": "^1.104.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "turbo": "^2.10.12",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  }
}

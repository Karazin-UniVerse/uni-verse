{
  "name": "uni-verse",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:select": "node scripts/dev.mjs",
    "build": "turbo build",
    "lint": "oxlint --deny-warnings",
    "lint:ox": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings && stylelint \"**/*.{css,scss}\" --fix && prettier --write .",
    "lint:style": "stylelint \"**/*.{css,scss}\"",
    "lint:style:fix": "stylelint \"**/*.{css,scss}\" --fix",
    "fix": "pnpm lint:fix",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "vitest run --config tests/e2e/vitest.config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "skills:sync": "node scripts/sync-skills.mjs",
    "skills:check": "node scripts/sync-skills.mjs --check",
    "gemini:sync": "node scripts/sync-gemini-context.mjs",
    "gemini:check": "node scripts/sync-gemini-context.mjs --check",
    "prepare": "husky",
    "grip:setup": "node scripts/grip/cli.mjs setup",
    "grip:remove": "node scripts/grip/cli.mjs remove",
    "grip:status": "node scripts/grip/cli.mjs status",
    "test:grip": "node --test scripts/tests/grip*.test.mjs",
    "db:generate": "pnpm --filter @universe/backend db:generate",
    "db:migrate": "pnpm --filter @universe/backend db:push",
    "db:migrate:force": "pnpm --filter @universe/backend db:push:force",
    "db:studio": "pnpm --filter @universe/backend db:studio",
    "lhci": "node scripts/lhci-run.cjs",
    "test:lhci": "node --test scripts/tests/lhci*.test.cjs",
    "graphify:extract": "node scripts/graphify.cjs extract",
    "graphify:query": "node scripts/graphify.cjs query",
    "test:graphify": "node --test scripts/tests/graphify.test.cjs",
    "graphify": "node scripts/graphify.cjs"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "puppeteer-core": "^25.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass-embedded": "^1.105.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "turbo": "^2.11.8",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}

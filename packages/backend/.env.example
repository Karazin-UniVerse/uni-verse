# Server Configuration
PORT=3001
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/universe?schema=public"

# JWT Authentication Secrets
AT_SECRET="your-access-token-secret-key"
RT_SECRET="your-refresh-token-secret-key"

# Moodle Integration
MOODLE_BASEURL="https://moodle.karazin.ua"
MOODLE_TIMEOUT=15000

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

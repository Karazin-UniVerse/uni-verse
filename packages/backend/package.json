{
  "name": "@universe/backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "db:generate": "prisma generate",
    "db:backfill-roles": "prisma db execute --file prisma/scripts/backfill-roles.sql",
    "db:push": "pnpm db:backfill-roles && prisma db push",
    "db:push:force": "pnpm db:backfill-roles && prisma db push --accept-data-loss",
    "build": "pnpm --filter @universe/core build && pnpm db:generate && pnpm --filter @universe/grip-backend build && nest build",
    "format": "prettier --write \"**/*.ts\" \"test/**/*.ts\"",
    "dev": "pnpm start:dev",
    "start": "pnpm --filter @universe/core build && pnpm db:generate && pnpm --filter @universe/grip-backend build && nest start",
    "start:dev": "pnpm --filter @universe/core build && pnpm db:generate && pnpm --filter @universe/grip-backend build && node -e \"console.warn('Grip backend changes require restarting start:dev')\" && nest start --watch",
    "start:debug": "pnpm --filter @universe/core build && pnpm db:generate && pnpm --filter @universe/grip-backend build && node -e \"console.warn('Grip backend changes require restarting start:debug')\" && nest start --debug --watch",
    "start:prod": "pnpm db:push && node dist/main",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "pnpm db:generate && node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules -r tsconfig-paths/register -r ts-node/register node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "test:grip:postgres": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-grip-postgres.json --runInBand",
    "test:grip:hosted:postgres": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-grip-hosted-postgres.json --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@universe/core": "workspace:*",
    "@universe/database": "workspace:*",
    "@universe/grip-backend": "workspace:*",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.2",
    "morgan": "^1.12.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "proxy-addr": "^2.0.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.9.9",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.11",
    "@types/proxy-addr": "^2.0.3",
    "@types/supertest": "^7.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "..",
    "roots": [
      "<rootDir>/backend",
      "<rootDir>/grip/backend"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "<rootDir>/backend/node_modules/ts-jest",
        {
          "tsconfig": "<rootDir>/backend/tsconfig.json"
        }
      ]
    },
    "moduleNameMapper": {
      "^@universe/grip-backend/constants$": "<rootDir>/grip/backend/grip.constants.ts",
      "^@universe/grip-backend/(.*)$": "<rootDir>/grip/backend/$1.ts",
      "^@universe/grip-backend$": "<rootDir>/grip/backend/grip.module.ts",
      "^@universe/core/(.*)$": "<rootDir>/core/$1"
    },
    "collectCoverageFrom": [
      "backend/**/*.(t|j)s",
      "grip/backend/**/*.(t|j)s",
      "!backend/dist/**",
      "!grip/backend/dist/**",
      "!backend/coverage/**",
      "!backend/test/**",
      "!**/node_modules/**",
      "!backend/prisma.config.ts",
      "!backend/prisma/seed*.ts",
      "!backend/main.ts",
      "!**/*.module.ts",
      "!**/*.dto.ts",
      "!backend/types/**"
    ],
    "coverageReporters": [
      "text",
      "lcovonly"
    ],
    "coverageDirectory": "<rootDir>/backend/coverage",
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "grip-quota\\.integration\\.spec\\.ts$",
      "grip/backend/hosted/tests/.*\\.postgres\\.spec\\.ts$"
    ]
  }
}

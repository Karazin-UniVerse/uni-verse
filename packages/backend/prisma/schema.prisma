datasource db {
  provider = "postgresql"
}

generator client {
  provider      = "prisma-client-js"
  output        = "../../database/client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl", "debian-openssl-3.0.x"]
}

enum Role {
  OPPORTUNITIES_USER
  MOODLE_STUDENT
  INSTRUCTOR
  ADMIN
  OPPORTUNITIES_MODERATOR
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  password     String
  roles        Role[]   @default([OPPORTUNITIES_USER])
  token        String?
  moodleId     String?
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  courses                    Course[]                     @relation("CourseInstructors")
  enrollments                Enrollment[]
  ownedOpportunities         Opportunity[]                @relation("OpportunityOwner")
  opportunityApplications    OpportunityApplication[]     @relation("Applicant")
  notifications              Notification[]               @relation("UserNotifications")
  comments                   Comment[]
  phone                      UserPhone?
  teachingAssignments        TeachingAssignment[]
  createdTimetableVersions   TimetableVersion[]           @relation("TimetableVersionCreator")
  teacherUnavailabilities    TeacherUnavailability[]
  slotPreferences            TeacherSlotPreference[]
  calendarSubscriptionTokens CalendarSubscriptionToken[]
  academicGroupId            String?
  academicGroup              AcademicGroup?               @relation(fields: [academicGroupId], references: [id])
  academicSubgroupId         String?
  academicSubgroup           AcademicSubgroup?            @relation(fields: [academicSubgroupId], references: [id])
  rescheduleRequests         TimetableRescheduleRequest[] @relation("RescheduleRequester")
  reviewedRescheduleRequests TimetableRescheduleRequest[] @relation("RescheduleReviewer")
  rescheduleAudits           TimetableRescheduleAudit[]
}

model UserPhone {
  userId      String @id
  phoneNumber String @unique
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id          String   @id @default(uuid())
  title       String
  description String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  instructorId String
  instructor   User   @relation("CourseInstructors", fields: [instructorId], references: [id])

  enrollments Enrollment[]
}

model Enrollment {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

enum OpportunityStatus {
  DRAFT
  READY_FOR_REVIEW
  REQUIRES_CHANGES
  PUBLISHED
  REJECTED
}

enum OpportunityLifecycleState {
  START
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum PaymentType {
  PAID
  UNPAID
}

enum OpportunityTag {
  RESEARCH
  STUDY_PROJECT
  INTERNSHIP
  STARTUP
  CHALLENGE
  VOLUNTEERING
  MENTORING
  IT
  ENGINEERING
  NATURAL_SCIENCES
  BUSINESS
  HUMANITIES
  LAW
  MEDIA_DESIGN
  MEDICINE
  NO_EXPERIENCE
  BASIC_KNOWLEDGE
  ADVANCED
  REMOTE
  KHARKIV
  UKRAINE
  ABROAD
}

model Opportunity {
  id                    String                    @id @default(uuid())
  title                 String
  description           String
  ownerContactInfo      String
  partnerInfo           String?
  status                OpportunityStatus         @default(DRAFT)
  lifecycleState        OpportunityLifecycleState @default(START)
  acceptsApplications   Boolean                   @default(false)
  paymentType           PaymentType               @default(UNPAID)
  paymentDetails        String?
  details               String?
  moderationComment     String?
  moderationContentHash String?
  tags                  OpportunityTag[]          @default([])
  publishedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation("OpportunityOwner", fields: [ownerId], references: [id])

  applications OpportunityApplication[] @relation("OpportunityToApplication")
  comments     Comment[]

  @@index([status, publishedAt(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model OpportunityApplication {
  id               String            @id @default(uuid())
  applicantName    String
  contactInfo      String
  briefDescription String?
  motivation       String?
  answers          String?
  status           ApplicationStatus @default(SUBMITTED)
  ownerComment     String?
  withdrawalCount  Int               @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunityId String
  opportunity   Opportunity @relation("OpportunityToApplication", fields: [opportunityId], references: [id])

  applicantId String
  applicant   User   @relation("Applicant", fields: [applicantId], references: [id])

  comments Comment[]

  @@unique([applicantId, opportunityId])
}

model Notification {
  id        String   @id @default(uuid())
  type      String?
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation("UserNotifications", fields: [userId], references: [id])
}

model Comment {
  id        String   @id @default(uuid())
  text      String
  createdAt DateTime @default(now())

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  applicationId String?
  application   OpportunityApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model GripSession {
  id          String    @id @default(uuid())
  tokenHash   String    @unique
  githubId    String
  githubLogin String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?

  @@index([expiresAt])
  @@index([githubId])
}

model GripQuotaBucket {
  key          String   @id
  windowEndsAt DateTime
  count        Int

  @@index([windowEndsAt])
}

model GripLease {
  id        String   @id @default(uuid())
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

enum TeachingType {
  LECTURE
  PRACTICAL
  SEMINAR
  LABORATORY
}

enum TimetableStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model AcademicGroup {
  id           String   @id @default(uuid())
  code         String   @unique
  degreeLevel  String
  studyForm    String
  entryYear    Int
  academicYear String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subgroups           AcademicSubgroup[]
  streams             AcademicStream[]
  teachingAssignments TeachingAssignment[]
  users               User[]

  @@index([academicYear])
}

model AcademicSubgroup {
  id              String   @id @default(uuid())
  name            String
  academicGroupId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  academicGroup       AcademicGroup        @relation(fields: [academicGroupId], references: [id], onDelete: Cascade)
  teachingAssignments TeachingAssignment[]
  users               User[]

  @@unique([academicGroupId, name])
  @@index([academicGroupId])
}

model AcademicStream {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groups              AcademicGroup[]
  teachingAssignments TeachingAssignment[]
}

model CurriculumPlan {
  id           String   @id @default(uuid())
  faculty      String
  title        String
  academicYear String
  semester     Int
  isDraft      Boolean  @default(true)
  isArchived   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teachingAssignments TeachingAssignment[]

  @@index([academicYear, semester])
}

model TeachingAssignment {
  deletedAt                DateTime?
  id                       String       @id @default(uuid())
  curriculumPlanId         String
  disciplineTitle          String
  teachingType             TeachingType
  academicHours            Int
  teacherId                String?
  groupId                  String?
  subgroupId               String?
  streamId                 String?
  isSaturdayOnly           Boolean      @default(false)
  hasLateSlotAuthorization Boolean      @default(false)
  meetingUrl               String?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  curriculumPlan CurriculumPlan    @relation(fields: [curriculumPlanId], references: [id], onDelete: Restrict)
  teacher        User?             @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  group          AcademicGroup?    @relation(fields: [groupId], references: [id], onDelete: Restrict)
  subgroup       AcademicSubgroup? @relation(fields: [subgroupId], references: [id], onDelete: Restrict)
  stream         AcademicStream?   @relation(fields: [streamId], references: [id], onDelete: Restrict)
  events         TimetableEvent[]

  @@index([curriculumPlanId])
  @@index([teacherId])
  @@index([groupId])
  @@index([subgroupId])
  @@index([streamId])
}

model SemesterCalendar {
  id              String   @id @default(uuid())
  academicYear    String
  semester        Int
  startDate       DateTime
  teachingWeeks   Int
  excludedDates   String[] @default([])
  makeupSaturdays Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  timetableVersions TimetableVersion[]
  slotPreferences   TeacherSlotPreference[]

  @@unique([academicYear, semester])
}

enum SlotPreference {
  PREFERRED
  UNDESIRABLE
}

model TeacherSlotPreference {
  id                 String           @id @default(uuid())
  teacherId          String
  semesterCalendarId String
  weekday            Int
  pair               Int
  preference         SlotPreference
  teacher            User             @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  semesterCalendar   SemesterCalendar @relation(fields: [semesterCalendarId], references: [id], onDelete: Restrict)

  @@unique([teacherId, semesterCalendarId, weekday, pair])
  @@index([semesterCalendarId])
}

model TimetableVersion {
  id                 String          @id @default(uuid())
  semesterCalendarId String
  status             TimetableStatus @default(DRAFT)
  candidateIndex     Int?
  generationId       String?
  publishedAt        DateTime?
  createdById        String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  semesterCalendar SemesterCalendar @relation(fields: [semesterCalendarId], references: [id], onDelete: Restrict)
  createdBy        User             @relation("TimetableVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  events           TimetableEvent[]

  @@index([semesterCalendarId])
  @@index([createdById])
  @@index([status])
  @@index([generationId])
}

model TimetableEvent {
  id                      String        @id @default(uuid())
  timetableVersionId      String
  teachingAssignmentId    String
  stableKey               String
  date                    DateTime
  pair                    Int
  pairSpan                Int           @default(1)
  meetingUrlOverride      String?
  disciplineTitleSnapshot String?
  teachingTypeSnapshot    TeachingType?
  teacherIdSnapshot       String?
  isCancelled             Boolean       @default(false)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  timetableVersion      TimetableVersion                @relation(fields: [timetableVersionId], references: [id], onDelete: Cascade)
  teachingAssignment    TeachingAssignment              @relation(fields: [teachingAssignmentId], references: [id], onDelete: Restrict)
  rescheduleRequests    TimetableRescheduleRequest[]
  rescheduleOccurrences TimetableRescheduleOccurrence[]
  rescheduleAudits      TimetableRescheduleAudit[]

  @@index([timetableVersionId])
  @@index([teachingAssignmentId])
  @@index([date, pair])
  @@index([stableKey])
}

enum RescheduleScope {
  ONCE
  SERIES
}

enum RescheduleRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model TimetableRescheduleRequest {
  id                  String                  @id @default(uuid())
  requesterId         String
  eventId             String
  newDate             DateTime
  newPair             Int
  scope               RescheduleScope
  reason              String                  @db.VarChar(1000)
  status              RescheduleRequestStatus @default(PENDING)
  reviewerId          String?
  decisionExplanation String?                 @db.VarChar(1000)
  decidedAt           DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  requester   User                            @relation("RescheduleRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  reviewer    User?                           @relation("RescheduleReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  event       TimetableEvent                  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  occurrences TimetableRescheduleOccurrence[]
  audits      TimetableRescheduleAudit[]

  @@index([requesterId, createdAt, id])
  @@index([status, createdAt, id])
  @@index([reviewerId])
  @@index([eventId])
}

model TimetableRescheduleOccurrence {
  id            String   @id @default(uuid())
  requestId     String
  eventId       String
  oldDate       DateTime
  oldPair       Int
  newDate       DateTime
  newPair       Int
  sourceContext Json

  request TimetableRescheduleRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  event   TimetableEvent             @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@unique([requestId, eventId])
  @@index([eventId])
}

model TimetableRescheduleAudit {
  id        String   @id @default(uuid())
  actorId   String
  requestId String?
  eventId   String
  reason    String   @db.VarChar(1000)
  oldDate   DateTime
  oldPair   Int
  newDate   DateTime
  newPair   Int
  createdAt DateTime @default(now())

  actor   User                        @relation(fields: [actorId], references: [id], onDelete: Restrict)
  request TimetableRescheduleRequest? @relation(fields: [requestId], references: [id], onDelete: Restrict)
  event   TimetableEvent              @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@unique([requestId, eventId])
  @@index([actorId])
  @@index([eventId, createdAt])
}

model TeacherUnavailability {
  id          String   @id @default(uuid())
  teacherId   String
  date        DateTime
  pair        Int
  isConfirmed Boolean  @default(false)
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher User @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@unique([teacherId, date, pair])
  @@index([teacherId])
  @@index([date, pair])
}

model CalendarSubscriptionToken {
  id             String    @id @default(uuid())
  userId         String
  token          String    @unique
  isActive       Boolean   @default(true)
  lastAccessedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}

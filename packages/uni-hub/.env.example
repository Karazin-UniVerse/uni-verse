# Next.js loads .env* files only from this package directory, never from the repository root.
# Copy this file to .env.local (`pnpm dev:select` does it for you).
# NEXT_PUBLIC_* values are inlined at build time: restart `next dev` after a change.

# Server Configuration
PORT=3000

# Backend API
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Google OAuth 2.0 (SSO)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Opportunities / Internships module toggle
NEXT_PUBLIC_FEATURE_OPPORTUNITIES=false

# Moodle LMS integration toggle (courses, grades, assignments sync)
NEXT_PUBLIC_FEATURE_MOODLE=true

# eDean academic system toggle (schedule, academic status)
NEXT_PUBLIC_FEATURE_EDEAN=true

# Developer feature flags control panel
NEXT_PUBLIC_FEATURE_PANEL=false
